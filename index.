<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EcoTracker – Carbon Footprint Calculator</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background-color: #f4f9f4;
      color: #2f4f4f;
    }
    header {
      background-color: #5a8768;
      color: white;
      padding: 20px;
      text-align: center;
    }
    section {
      padding: 20px;
      max-width: 900px;
      margin: auto;
    }
    .card {
      background: white;
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    label {
      display: block;
      margin-top: 10px;
      font-weight: bold;
    }
    input {
      width: 100%;
      padding: 8px;
      margin-top: 5px;
    }
    button {
      margin-top: 15px;
      padding: 10px 15px;
      background-color: #5a8768;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover {
      background-color: #4a7258;
    }
    footer {
      text-align: center;
      padding: 10px;
      background-color: #c9ed96;
      font-size: 14px;
    }
  </style>
</head>
<body>

<header>
  <h1>EcoTracker</h1>
  <p>Track Your Carbon Footprint & Carbon Credits</p>
</header>

<section>
  <div class="card">
    <h2>Carbon Footprint Calculator</h2>
    <label>Electricity Usage (units per month)</label>
    <input type="number" id="electricity" />

    <label>Transport Distance (km per day)</label>
    <input type="number" id="transport" />

    <label>Fuel Usage (litres per month)</label>
    <input type="number" id="fuel" />

    <button onclick="calculate()">Calculate</button>

    <h3 id="result"></h3>
    <p id="credits"></p>
    <p id="suggestion"></p>
  </div>

  <div class="card">
    <h2>What are Carbon Credits?</h2>
    <p>One carbon credit represents the reduction of one metric ton of carbon dioxide (CO₂). Individuals and organizations can offset their emissions by purchasing carbon credits.</p>
  </div>
</section>

<footer>
  © 2026 EcoTracker | Designed for Sustainability 🌱
</footer>

<script>
  function calculate() {
    const electricity = Number(document.getElementById('electricity').value) || 0;
    const transport = Number(document.getElementById('transport').value) || 0;
    const fuel = Number(document.getElementById('fuel').value) || 0;

    const electricityCO2 = electricity * 0.82; // kg CO2 per unit
    const transportCO2 = transport * 0.21 * 30; // monthly
    const fuelCO2 = fuel * 2.31;

    const total = electricityCO2 + transportCO2 + fuelCO2;
    const yearly = total * 12 / 1000;
    const credits = Math.ceil(yearly);

    document.getElementById('result').innerText = `Monthly Footprint: ${total.toFixed(2)} kg CO₂ | Yearly: ${yearly.toFixed(2)} tons CO₂`;
    document.getElementById('credits').innerText = `Carbon Credits Required: ${credits}`;

    document.getElementById('suggestion').innerText = "Tip: Use public transport, reduce electricity usage, and switch to renewable energy.";
  }
</script>

</body>
</html>
